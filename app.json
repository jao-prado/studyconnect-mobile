{
  "expo": {
    "name": "StudyConnect",
    "slug": "studyconnect-mobile",
    "scheme": "studyconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/studyconnect-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.studyconnect.mobile",
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/studyconnect-android-foreground.png",
        "monochromeImage": "./assets/studyconnect-android-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/studyconnect-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#8B5CF6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0F",
          "image": "./assets/studyconnect-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o StudyConnect acesse suas fotos para a imagem do perfil.",
          "cameraPermission": "Permitir que o StudyConnect use a câmera para tirar sua foto de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1cb6fab2-0299-48b3-b7a8-0bad8e5ec5a2"
      }
    },
    "owner": "asjps-team"
  }
}
